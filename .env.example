# Optional. If missing, Scout writes solid template notes from researched entities.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Nebius (OpenAI-compatible). Used when OPENAI_API_KEY is unset.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-fast

# Optional extra research. Demo works without it.
LINKUP_API_KEY=

# Optional path for the JSON job store (defaults to /tmp/sourceship-jobs.json).
# JOB_STORE_PATH=/tmp/sourceship-jobs.json
