# --- Research (LinkUp) ---
# When set, Reed searches live web via LinkUp. Names must appear in live results.
# Never invents people.
LINKUP_API_KEY=
# Optional file fallback (not committed). Default: /workspace/secrets/LINKUP_API_KEY
# LINKUP_API_KEY_FILE=/workspace/secrets/LINKUP_API_KEY

# --- Drafts + scores (Nebius preferred, OpenAI-compatible) ---
# When set, Tess writes coffee-chat notes and a confidence score.
NEBIUS_API_KEY=
# Optional file fallback (not committed). Default: /workspace/secrets/NEBIUS_API_KEY
# NEBIUS_API_KEY_FILE=/workspace/secrets/NEBIUS_API_KEY
NEBIUS_TOKEN=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-fast

# Alternate: OpenAI, or OpenAI-compatible base URL (including Nebius).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Runtime ---
# Persist jobs across the Render process (in-process worker).
JOB_STORE_PATH=/tmp/sourceship-jobs.json
